generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// USER & AUTH
// ==========================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  role      String   @default("ketua_kelas")
  className String?  @map("class_name")
  semester  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks         Task[]
  announcements Announcement[]
  notes         StickyNote[]
  activities    ActivityLog[]
  files         SharedFile[]
  reminders     Reminder[]
  settings      UserSettings?

  @@map("users")
}

model UserSettings {
  id                String  @id @default(cuid())
  userId            String  @unique
  theme             String  @default("dark")
  reminderDefault   String  @default("H-3")
  aiModel           String  @default("llama-3.3-70b-versatile")
  whatsappConnected Boolean @default(false)
  language          String  @default("id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ==========================================
// TASK MANAGER
// ==========================================

model Task {
  id          String     @id @default(cuid())
  userId      String
  courseId     String?
  dosenId     String?
  title       String
  description String?    @db.Text
  deadline    DateTime?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  attachments String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?       @relation(fields: [courseId], references: [id])
  dosen    Dosen?        @relation(fields: [dosenId], references: [id])
  subtasks Subtask[]
  history  TaskHistory[]

  @@index([userId])
  @@index([deadline])
  @@index([status])
  @@map("tasks")
}

model Subtask {
  id        String  @id @default(cuid())
  taskId    String
  title     String
  completed Boolean @default(false)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("subtasks")
}

model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  field     String
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_history")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// ==========================================
// COURSE & DOSEN
// ==========================================

model Course {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  semester  String?
  schedule  String?  @db.Text
  createdAt DateTime @default(now())

  tasks      Task[]
  dosen      Dosen[]     @relation("CourseDosen")
  elearnings ELearning[]
  materials  Material[]

  @@map("courses")
}

model Dosen {
  id           String  @id @default(cuid())
  name         String
  whatsapp     String?
  email        String?
  consultHours String?
  photoUrl     String?

  courses Course[] @relation("CourseDosen")
  tasks   Task[]

  @@map("dosen")
}

// ==========================================
// E-LEARNING REMINDER
// ==========================================

model ELearning {
  id          String   @id @default(cuid())
  courseId     String
  title       String
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime
  frequency   String   @default("2_weeks")
  reminders   String   @default("H-7,H-3,H-1,H-0")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("elearnings")
}

// ==========================================
// REMINDERS
// ==========================================

model Reminder {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?      @db.Text
  remindAt    DateTime
  type        ReminderType @default(GENERAL)
  target      String       @default("group")
  sent        Boolean      @default(false)
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([remindAt])
  @@index([sent])
  @@map("reminders")
}

enum ReminderType {
  GENERAL
  TASK
  ELEARNING
  EXAM
  ASSIGNMENT
}

// ==========================================
// ANNOUNCEMENTS
// ==========================================

model Announcement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String   @db.Text
  category    String   @default("general")
  attachments String?  @db.Text
  pinned      Boolean  @default(false)
  broadcast   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([category])
  @@map("announcements")
}

// ==========================================
// REPOSITORY MATERI
// ==========================================

model Material {
  id        String   @id @default(cuid())
  courseId   String
  name      String
  fileUrl   String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("materials")
}

// ==========================================
// FILE SHARING
// ==========================================

model SharedFile {
  id         String   @id @default(cuid())
  userId     String
  courseId   String?
  name       String
  fileUrl    String
  fileType   String
  fileSize   Int
  shareToken String?  @unique
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([shareToken])
  @@map("shared_files")
}

// ==========================================
// STICKY NOTES
// ==========================================

model StickyNote {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  color     String   @default("yellow")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sticky_notes")
}

// ==========================================
// ACTIVITY LOG
// ==========================================

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entity      String
  entityId    String?
  description String   @db.Text
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ==========================================
// CALENDAR EVENTS
// ==========================================

model CalendarEvent {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  startDate   DateTime
  endDate     DateTime?
  type        CalendarType @default(OTHER)
  color       String?
  allDay      Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([startDate])
  @@map("calendar_events")
}

enum CalendarType {
  KULIAH
  PRAKTIKUM
  SEMINAR
  PRESENTASI
  UTS
  UAS
  HOLIDAY
  DEADLINE
  ELEARNING
  OTHER
}

// ==========================================
// WHATSAPP SESSION
// ==========================================

model WhatsAppSession {
  id          String   @id @default(cuid())
  sessionData String?  @db.LongText
  status      String   @default("disconnected")
  groupId     String?
  groupName   String?
  updatedAt   DateTime @updatedAt

  @@map("whatsapp_sessions")
}
