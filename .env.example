# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="mysql://root:password@localhost:3306/ruangketua"

# ==========================================
# AUTH
# ==========================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
CRON_SECRET="change-this-cron-secret"

# ==========================================
# GROQ AI
# ==========================================
GROQ_API_KEY="gsk-your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# ==========================================
# ADMIN CREATION SCRIPT (optional, only for npm run admin:create)
# ==========================================
ADMIN_EMAIL="admin@ruangketua.id"
ADMIN_NAME="Admin"
ADMIN_PASSWORD="change-this-strong-admin-password"

# ==========================================
# APP
# ==========================================
NEXT_PUBLIC_APP_NAME="Ruang Ketua"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ==========================================
# FILE UPLOAD
# ==========================================
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="10485760"

# ==========================================
# GOOGLE DRIVE INTEGRATION
# ==========================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/cloud/google/callback"
DRIVE_TOKEN_SECRET="change-this-drive-token-secret-min-32-chars!!"
