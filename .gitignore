# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.err
/.devserver.log
/dev.log
/dev.err

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated
/src/generated/prisma

# whatsapp auth session
.whatsapp-auth/

# uploads (user files)
/public/uploads/*
!/public/uploads/.gitkeep

# local tool state
.claude/

# local database dumps
/dump_*.sql
